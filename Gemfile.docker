# Alternative Gemfile for Docker
# Replace path directives with volume mount paths

source "https://rubygems.org"
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby "3.3.6"

gem 'dotenv'
gem "rails", "7.0.4.3"
gem "sprockets-rails"
gem "puma", "~> 5.0"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "jbuilder"
gem "bootsnap", require: false
gem 'concurrent-ruby', '1.3.4'
gem 'pg'
gem 'pry'

# Forest Admin gems - using mounted volumes
gem 'forest_admin_rails', path: '/forest_admin_gems/forest_admin_rails'
gem 'forest_admin_agent', path: '/forest_admin_gems/forest_admin_agent'
gem 'forest_admin_datasource_toolkit', path: '/forest_admin_gems/forest_admin_datasource_toolkit'
gem 'forest_admin_datasource_active_record', path: '/forest_admin_gems/forest_admin_datasource_active_record'
gem 'forest_admin_datasource_customizer', path: '/forest_admin_gems/forest_admin_datasource_customizer'
gem 'forest_admin_datasource_mongoid', path: '/forest_admin_gems/forest_admin_datasource_mongoid'

group :development, :test do
  gem "debug", platforms: %i[ mri windows ]
end

group :development do
  gem "web-console"
end

group :test do
  gem "capybara"
  gem "selenium-webdriver"
  gem "webdrivers"
end
