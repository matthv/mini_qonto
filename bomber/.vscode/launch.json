    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Jest (Yarn PnP)",
            "args": ["--runInBand", "--watchAll=false"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            // Helpful for TS/ESM source stepping
            "sourceMaps": true
        }
    ]
}
